datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id // Stored as deviceId e.g. dev_xxxx
  baseCurrency String     @default("EUR")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  positions    Position[]

  @@map("users")
}

model Cryptocurrency {
  id        String     @id // e.g. "bitcoin"
  symbol    String     // e.g. "BTC"
  name      String     // e.g. "Bitcoin"
  logoUrl   String?
  status    String     @default("ACTIVE")
  positions Position[]

  @@map("cryptocurrencies")
}

model Position {
  id               String         @id @default(cuid())
  userId           String
  cryptocurrencyId String
  quantity         Float
  entryPrice       Float
  entryCurrency    String         @default("EUR")
  purchaseDate     String?
  fees             Float?         @default(0)
  exchange         String?
  wallet           String?
  notes            String?
  status           String         @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cryptocurrency   Cryptocurrency @relation(fields: [cryptocurrencyId], references: [id], onDelete: Cascade)
  alerts           Alert[]
  alertEvents      AlertEvent[]

  @@index([userId])
  @@index([cryptocurrencyId])
  @@index([status])
  @@map("positions")
}

model Alert {
  id              String       @id @default(cuid())
  positionId      String
  type            String       // PRICE, PROFIT_PERCENT, LOSS_PERCENT, ENTRY_PRICE
  direction       String       // ABOVE, BELOW
  threshold       Float
  targetPrice     Float
  repeatMode      String       @default("ONCE") // ONCE, REPEAT
  cooldownMinutes Int          @default(30)
  status          String       @default("ACTIVE") // ACTIVE, TRIGGERED, PAUSED
  lastTriggeredAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  position        Position     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  alertEvents     AlertEvent[]

  @@index([positionId])
  @@index([status])
  @@map("alerts")
}

model AlertEvent {
  id                   String   @id @default(cuid())
  alertId              String
  positionId           String
  coinSymbol           String
  conditionDescription String
  triggerPrice         Float
  actualPrice          Float
  triggeredAt          DateTime @default(now())
  delivered            Boolean  @default(true)
  channel              String   @default("IN_APP")
  eventKey             String?  @unique // Idempotency key to prevent duplicate alert events

  alert                Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  position             Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId])
  @@index([alertId])
  @@map("alert_events")
}
